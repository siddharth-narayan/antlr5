{% macro alt_members(alt) %}
{% for element in alt.elements %}
{% if element.Atom.atom.ID %}
{{ element.Atom.atom.ID }}: {{ element | etype_prefix }}{{ element.Atom.atom.ID | capitalize }}{{ element | etype_suffix }},
{% endif %}
{% endfor %}
{% endmacro %}

class Parser:
    {% for rule in rules %}
    def {{ rule.name }}(self):
        self.set_state({{ rule.name | startstate }});

    {% endfor %}

 Parser {
    {% for rule in rules %}
    def {{ rule.name }}(self):
        self.set_state({{ rule.name | startstate }});

    {% endfor %}
}

{% for rule in rules %}
{% if rule.alt_list.alts | length > 1 %}
pub enum {{ rule.name | capitalize }} {
    {% for alt in rule.alt_list.alts %}
    {{alt.label}} {
        {{ alt_members(alt) }}
    },
    {% endfor %}
}

{% else %}
pub struct {{ rule.name | capitalize }} {
    {% for alt in rule.alt_list.alts %}
    {{ alt_members(alt) }}
    {% endfor %}
}

impl {{ rule.name | capitalize }} {
    pub fn new() -> {{ rule.name | capitalize }} {

    }
}

{% endif %}
{% endfor %}