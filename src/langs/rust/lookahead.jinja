{% macro match_alts(alts) %}
{% set la = alts | lookahead_lookup_filter %}
{{ lookahead(la, alts) }}
{% endmacro %}

{% macro lookahead(la, alts) %}
{% if la.Terminal %}
    {% set alt = alts[la.Terminal.alt] %}
    {{ match_alt(alt, la.Terminal.continue_from) }}
    {{ alt.label | default("Alt" ~ la.Terminal.alt, true) }} {
        
    }
{% else %}
    match self.next() {
        {% for key, value in la.Continues.tree | items %}
        {{ key.TokenID }} => {
            {{ lookahead(value, alts) }}
        }
        {% endfor %}
    }
{% endif %}
{% endmacro %}

{% macro match_alt(alt, from) %}
{% for element in alt.elements[from:] %}
{% if element.Atom %}
    {% if element.Atom.atom.RuleID %}
        let {{ (element.Atom.atom.RuleID | rule_from_id).name }} = self.{{ (element.Atom.atom.RuleID | rule_from_id).name }}()?;
    {% else %}
        let token = self.match_token({{ element.Atom.atom.TokenID }})?;
    {% endif %}
{% else %}
    // TODO match block
{% endif %}
{% endfor %}
{% endmacro %}